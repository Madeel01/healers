{
  "expo": {
    "name": "Healers",
    "slug": "Healers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Healers to access your camera to record therapy sessions.",
          "microphonePermission": "Allow Healers to access your microphone to record audio during therapy sessions.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video"
    ]
  }
}
